# =============================================================================
# Nado DEX Configuration
# =============================================================================
# Get your private key from your Nado wallet.
# WARNING: Never commit your real private key to git.
NADO_PRIVATE_KEY=0x_your_private_key_here

# =============================================================================
# OKX Exchange Configuration (optional)
# =============================================================================
# Required only if using OKX live trading (live_okx_quant.py).
# Create API keys at: https://www.okx.com/account/my-api
OKX_API_KEY=your_api_key
OKX_API_SECRET=your_api_secret
OKX_PASSPHRASE=your_passphrase

# =============================================================================
# Network Proxy (optional)
# =============================================================================
# If you are in a region that requires a proxy to access exchange APIs,
# uncomment and set the following:
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
